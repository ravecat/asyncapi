{
  "asyncapi": "2.6.0",
  "info": { "title": "Operation mixed 2.6", "version": "1.0.0" },
  "channels": {
    "users/{userId}": {
      "subscribe": {
        "message": { "name": "UserEvent", "payload": { "type": "string" } }
      }
    },
    "a/b": {
      "publish": {
        "message": { "name": "SlashEvent", "payload": { "type": "number" } }
      }
    },
    "c~d": {
      "publish": {
        "operationId": "authoredOp",
        "message": { "name": "TildeEvent", "payload": { "type": "boolean" } }
      }
    }
  }
}
